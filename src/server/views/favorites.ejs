<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs', { title: "Your Favorites" })%>
<body>
    <%- include('./partials/header.ejs') %>
    <div id="main-container">
        <div id="faves-view-container">
            <div id="faves-view-nav-bar">
                <button id="back-btn">< Back</button>
            </div>
            <h1 id="faves-view-header">Your Favorites</h1>
            <div id="faves-view-content">
                <% favorites.forEach(recipe => {    %>
                    <div class="meal" data-id="<%= recipe.recipe_id%>" >
                        <div class="actions">
                            <button class="favorite filled" data-action="favorite"></button>
                        </div>
                        <div class="recipe-title">
                            <%= recipe.recipe_title %>
                        </div>
                        <div class="ready-time-container">
                            <button class="clock-icon"> </button>
                            <div class="recipe-ready-time">
                                <%= recipe.recipe_ready_time %>
                            </div>
                        </div>
                    </div> 
                <% })%>
            </div>
        </div>
    </div>
    <script src="/client/favorites.js"></script>
</body>
</html>