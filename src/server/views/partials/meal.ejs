    <div class="meal" data-id="<%= meal.recipe_id %>">
        <% if (meal.recipe_id !== null) { %>
        <div class="actions">
            <button class="single-regenerate" data-action="regenerate"></button>
            <button class="favorite <%= meal.favorite ? filled : '' %>" data-action="favorite"></button>
        </div>
        <div class="recipe-title"> <%= meal.recipe_title %> </div>
        <div class="ready-time-container">
            <button class="clock-icon"> </button>
            <div class="recipe-ready-time"> <%= meal.recipe_ready_time %> </div>
        </div>
        <div class="weather-info"> <%= meal.temp %> °F</div>
        <div class="time"> <%= meal.meal_time %> </div>
        <% } %>
    </div> 