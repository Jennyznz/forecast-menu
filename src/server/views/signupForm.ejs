<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs', { title: "Sign Up Form" })%>
<body>
    <%- include('./partials/header.ejs') %>
    <div id="main-container">
        <div id="sign-up-container">
            <div id="form-switch">
                <span>Already have an account?</span>
                <span>Click <a href="/user/login">here</a> to login</span>
            </div>
            <form action="" method="POST" id="sign-up-form" novalidate>
                <h2 id="sign-up-header">Sign Up</h2>

                <label for="username">Username</label> 
                <input id="username" name="username" type="text" required> <br>
                <span id="username-err-msg"></span>
                <br>
                <label for="password">Password</label> 
                <input type="text" id="password" name="password" required> <br>
                <span id="pw-err-msg"></span>
                <br>
                <label for="confirm-password">Confirm Password</label>
                <input type="text" id="confirm-password" name="confirm-password" required> <br>
                <span id="confirm-pw-err-msg"></span>
                <br>
                <br>
                <button id="sign-up-submit">Submit</button>
            </form>

            <div id="success-message" style="display: none; text-align: center;">
                Your account has been created. Click <a href="/user/login">here</a> to login.
            </div>
            <div id="failure-message" style="display: none; text-align: center;">
                <span id="failure-details"></span>
                Click <a href="/user/signup">here</a> to try again.
            </div>
        </div>
    </div>
    <script src="/main.js"></script>
</body>
</html>