<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs')%>
<body>
    <%- include('./partials/header.ejs') %>
    <div id="main-container">
        <div id="sign-up-container">
            <div id="form-switch">
                <div>Already have an account?</div>
                <div>Click <a href="/user/login">here</a> to login</div>
            </div>
            <form action="/sign-up" method="POST" id="sign-up-form">
                <h2 id="sign-up-header">Sign Up</h2>

                <label for="username">Username</label> 
                <input id="username" name="username" type="text" required> <br>
                <br>
                <label for="password">Password</label> 
                <input type="text" id="password" name="password" required> <br>
                <br>
                <label for="confirm-password">Confirm Password</label>
                <input type="text" id="confirm-password" name="confirm-password" required> <br>
                <br>
                <br>
                <button id="sign-up-btn">Submit</button>
            </form>
        </div>
    </div>
</body>
</html>