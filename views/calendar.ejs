<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs', { title: "Weekly Picks"}) %>
</head>
<body>
    <%- include('./partials/header.ejs') %>
    <div id="main-container">
        <h1 id="calendar-label">Weekly Picks (<%= weekLabel %>) </h1>
        <div id="content-area">
            <div id="overview">
                <p id="summary">
                    The weather decides the mood. <br>
                    The mood decides the meal. <br>
                    Rainy day soup. <br>
                    Sunny day salad. <br>
                    We've got you covered.
                </p>
                <button id="regenerate"></button>
                <button id="shopping-cart"></button>
            </div>
            <div id="spread">
                <% 
                    for (let i = 0; i < weekDays.length; i++) {  
                        const weekDay = weekDays[i];
                %>
                        <%- include('./partials/day.ejs', { 
                                weekDay,
                                weekDate: weekDates[i],
                                breakfast: mealPlan[weekDay]["Breakfast"],
                                lunch: mealPlan[weekDay]["Lunch"],
                                dinner: mealPlan[weekDay]["Dinner"]
                            }) 
                        %>
                <% } %>

            </div>
        </div>
    </div>
</body>
</html> 