<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs', { title: recipe.title }) %>
<body>
    <%- include('./partials/header.ejs') %>

    <div id="main-container">
        <div id="recipe-view-container">
            <div id="toolbar">
                <div id="toolbar-left">
                    <button id="back-btn">< Back</button>
                </div>
                <div id="toolbar-right">
                    <button id="recipe-view-fave-btn"></button>
                </div>
            </div>
            <h1 id="title">
                <%= recipe.title %>
            </h1>
            <img src=<%= recipe.image %> alt="Image of recipe" id="recipe-view-photo">
             <div id="ingredients-container">
                <h2 id="ingredienets-label">Ingredients: </h2>
                <ul id="ingredients-list">
                    <% recipe.ingredients.forEach(ingredient => { %>
                        <li class="ingredient">
                            <%= ingredient.name %>
                            <%= ingredient.amount %>
                            <%= ingredient.unit %>
                        </li>
                    <% }) %>
                </ul>
             </div>
        </div>
    </div>
</body>
</html>